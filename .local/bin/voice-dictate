#!/usr/bin/env bash
set -euo pipefail

dir="${XDG_RUNTIME_DIR:-/tmp}/voice-dictate"
pidfile="$dir/pw-record.pid"
wav="$dir/take.wav"
model="${OPENAI_TRANSCRIBE_MODEL:-gpt-4o-mini-transcribe}"
env_file="$HOME/.env"

mkdir -p "$dir"

notify() {
  printf '%s\n' "$1" >&2
  notify-send "Voice dictation" "$1"
}

fail() {
  notify "$1"
  exit 1
}

for cmd in curl jq pw-record wtype; do
  command -v "$cmd" >/dev/null 2>&1 || fail "Missing dependency: $cmd"
done

if [[ -z "${OPENAI_API_KEY:-}" && -f "$env_file" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
fi

[[ -n "${OPENAI_API_KEY:-}" ]] || fail "OPENAI_API_KEY is not set"

if [[ -f "$pidfile" ]]; then
  pid="$(cat "$pidfile")"

  if kill -0 "$pid" 2>/dev/null; then
    notify "Recording stopped"
    kill -INT "$pid" 2>/dev/null || true

    for _ in $(seq 1 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
  fi

  rm -f "$pidfile"

  [[ -s "$wav" ]] || fail "No audio was recorded"

  notify "Transcribing..."

  text="$(
    curl -sS https://api.openai.com/v1/audio/transcriptions \
      -H "Authorization: Bearer $OPENAI_API_KEY" \
      -F "file=@${wav};type=audio/wav" \
      -F "model=${model}" \
    | jq -r '.text // empty'
  )"

  text="${text//$'\r'/ }"
  text="${text//$'\n'/ }"

  [[ -n "$text" ]] || fail "Transcription failed"

  wtype -- "$text"
  notify "Inserted transcript"
  exit 0
fi

rm -f "$wav"
notify "Recording started"
pw-record --rate 16000 --channels 1 "$wav" >/dev/null 2>&1 &
echo $! > "$pidfile"
